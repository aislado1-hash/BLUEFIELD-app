# Copia este fichero a .env y rellena la key. .env está en .gitignore: NUNCA se sube.
AI33_API_KEY=
# auto = AI33 si hay key, si no TTS local de prueba (espeak-ng). Valores: auto | ai33 | local
TTS_PROVIDER=auto
# Opcionales (ajustes del cliente AI33 sin tocar código):
# AI33_BASE_URL=https://api.ai33.pro
# AI33_AUTH_HEADER=xi-api-key        # o Authorization (se envía como Bearer)
# AI33_MODEL_ID=
# AI33_EXTRA_JSON={"output_format":"mp3_44100_128"}
